rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function hasUserProfile() {
      return signedIn()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function isApproved() {
      return hasUserProfile()
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.aprovado == true;
    }

    match /registrosClientes/{id} {
      allow read, create: if isAdmin() || isApproved();
      allow update, delete: if isAdmin();
    }

    match /clientes/{cnpj} {
      allow read, create: if isAdmin() || isApproved();
      allow update, delete: if isAdmin();
    }

    match /usuarios/{uid} {
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.aprovado == false
        && request.resource.data.recusado == false
        && request.resource.data.email == request.auth.token.email;

      allow read: if signedIn()
        && (request.auth.uid == uid || isAdmin());

      allow update, delete: if isAdmin();
    }

    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update, delete: if false;
    }

    match /mail/{id} {
      allow read, create, update, delete: if false;
    }
  }
}
